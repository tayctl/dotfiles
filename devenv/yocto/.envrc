eval "$(devenv -q direnvrc)"

# Quiet autoload: the stock `use devenv` prints its task runner status
# (• Running devenv:files:cleanup, ✓ ... in Nms, etc.) on every load. Build
# the env ourselves and only surface output on failure.
_yocto_devenv() {
  local root="$HOME/dotfiles/devenv/yocto"
  watch_file "$root/devenv.nix" "$root/devenv.yaml" "$root/devenv.lock"

  local errfile out
  errfile=$(mktemp)
  if ! out=$(devenv -q --from path:"$root" direnv-export 2>"$errfile"); then
    cat "$errfile" >&2
    rm -f "$errfile"
    log_error "yocto devenv failed to load"
    return 1
  fi
  rm -f "$errfile"
  _nix_import_env "$out"
}
_yocto_devenv && log_status "devenv active"
