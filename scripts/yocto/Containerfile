FROM docker.io/library/debian:12

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Yocto host requirements ("Required Packages for the Build Host") + extras
# commonly needed for repo/QCOM-based BSPs and for running bitbake headless.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential chrpath cpio debianutils diffstat file gawk gcc git \
        iputils-ping libacl1 lz4 locales python3 python3-git python3-jinja2 \
        python3-pexpect python3-pip python3-subunit socat texinfo unzip wget \
        xz-utils zstd \
        ca-certificates curl git-lfs rsync bc python-is-python3 \
        openssh-client less vim-tiny procps \
    && sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# Google's repo tool (not packaged in Debian main for bookworm)
RUN curl -fsSL https://storage.googleapis.com/git-repo-downloads/repo -o /usr/local/bin/repo \
    && chmod 0755 /usr/local/bin/repo

# Qualcomm's set_bb_env.sh refuses to run unless /bin/sh is bash and $SHELL
# is bash
RUN ln -sf bash /bin/sh
ENV SHELL=/bin/bash

ENV LANG=en_US.UTF-8

# MACHINE and DISTRO are deliberately not set here: bitbake always takes them
# from the environment, which would override the projects' local.conf
ENV OTA_MODE=1
ENV RELEASE_MODE=0

# Run builds with yb.sh next to this file, see its header for usage.
